: 1790, "prompt_tokens": 1202, "completion_tokens": 501, "done_reason": "stop", "gen_cut": false, "error": null, "truncated_log": null, "ctx_full_suspect": false, "t_retrieve": 0.122, "t_rerank": 0.0, "t_llm": 28.465, "t_total": 28.587}
